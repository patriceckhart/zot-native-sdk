{
  "name": "@zot/native-core",
  "version": "0.0.1",
  "description": "Shared TypeScript types for zot native SDK integrations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patriceckhart/zot-native-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/patriceckhart/zot-native-sdk#readme",
  "bugs": "https://github.com/patriceckhart/zot-native-sdk/issues",
  "keywords": ["zot", "ai", "agent", "native"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
